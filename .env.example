# ==============================================================================
# Envoyr Environment Variables & Secrets (.env.example)
#
# Copy this file to .env.local and populate with your actual credentials:
#   cp .env.example .env.local
#
# NOTE: .env.local is ignored in .gitignore and will never be committed to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neatlogs Observability & Tracing (Phase 6)
# ------------------------------------------------------------------------------
# API key used for authenticating traces with neatlogs telemetry backend.
NEATLOGS_API_KEY=your_neatlogs_api_key_here

# Telemetry ingestion endpoint URL.
# Example: https://api.neatlogs.com/v1/traces
NEATLOGS_ENDPOINT=https://api.neatlogs.com/v1/traces

# ------------------------------------------------------------------------------
# 2. Remote Worker & Micro-VM Execution (Phase 7)
# ------------------------------------------------------------------------------
# Remote worker target host specification.
# Formats:
#   - ssh://username@host_or_ip: Run commands on remote Linux VPS / micro-VM via SSH
#   - sandbox://linux-micro-vm: Run in isolated local simulation runner (default)
ENVOYR_REMOTE_HOST=sandbox://linux-micro-vm

# Optional absolute path to SSH private key identity file for remote worker.
# Example on Windows: C:\Users\<username>\.ssh\id_rsa
# Example on Linux/macOS: /home/<username>/.ssh/id_rsa
ENVOYR_REMOTE_SSH_KEY=envoyr_remote_ssh_key_here

# ------------------------------------------------------------------------------
# 3. CFO.ai Unit Economics & Compute Modeling (Phase 6)
# ------------------------------------------------------------------------------
# API key and endpoint for CFO.ai cloud infrastructure economics benchmarking.
CFO_AI_API_KEY=your_cfo_ai_api_key_here
CFO_AI_ENDPOINT=https://api.cfo.ai/v1/benchmarks

# ------------------------------------------------------------------------------
# 4. Dynamic LLM Orchestrator Engine (Agentic Research)
# ------------------------------------------------------------------------------
# Google Gemini API key for real-time natural language intent research and DAG synthesis.
# (Recommended: Get a free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

